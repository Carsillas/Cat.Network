  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../README.md" LogicalName="RepositoryReadme.md" />
    <EmbeddedResource Include="WorldStorage.cs" LogicalName="WorldStorage.cs" />
  </ItemGroup>
</Project>
